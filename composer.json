{
    "name": "forgemesh/pay-per-crawl-laravel",
    "description": "Laravel middleware that charges AI crawlers per page with x402 / MPP USDC micropayments on Base, paid straight to your wallet. Hit analytics included.",
    "type": "library",
    "license": "MIT",
    "keywords": ["laravel", "x402", "mpp", "402", "pay-per-crawl", "ai-crawlers", "usdc", "base", "middleware"],
    "homepage": "https://forgemesh.io/pay-per-crawl",
    "authors": [{"name": "ForgeMesh Labs", "homepage": "https://forgemesh.io"}],
    "support": {"issues": "https://github.com/forgemeshlabs/pay-per-crawl-laravel/issues", "source": "https://github.com/forgemeshlabs/pay-per-crawl-laravel"},
    "require": {
        "php": "^8.1",
        "forgemesh/pay-per-crawl-core": "^0.1",
        "illuminate/console": "^10.0|^11.0|^12.0|^13.0",
        "illuminate/contracts": "^10.0|^11.0|^12.0|^13.0",
        "illuminate/database": "^10.0|^11.0|^12.0|^13.0",
        "illuminate/http": "^10.0|^11.0|^12.0|^13.0",
        "illuminate/routing": "^10.0|^11.0|^12.0|^13.0",
        "illuminate/support": "^10.0|^11.0|^12.0|^13.0"
    },
    "autoload": {"psr-4": {"ForgeMesh\\PayPerCrawl\\Laravel\\": "src/"}},
    "extra": {
        "laravel": {"providers": ["ForgeMesh\\PayPerCrawl\\Laravel\\PayPerCrawlServiceProvider"]}
    },
    "config": {"sort-packages": true},
    "minimum-stability": "stable"
}
